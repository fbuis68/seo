NODE_ENV=production
# Port local de l'application (reverse proxy nginx de l'hôte → 127.0.0.1:WEB_PORT)
WEB_PORT=8080
# Domaines (DNS A vers l'IP du serveur) — utilisés par le conteneur caddy optionnel
APP_DOMAIN=app.exemple.fr
SITE_DOMAINS=www.exemple.fr, exemple.fr
ACME_EMAIL=admin@exemple.fr
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
# Clé maître AES-256 (32 octets en base64) : openssl rand -base64 32
SECRET_KEY=
PUBLIC_API_URL=https://app.exemple.fr
APP_URL=https://app.exemple.fr
# PUBLIC_API_URL et APP_URL : laissés à la valeur d'exemple, ils sont remplacés par https://APP_DOMAIN.
# Comptes éditeur ayant accès au back-office (emails séparés par des virgules, email vérifié requis)
PLATFORM_ADMINS=
# Origines autorisées à afficher le widget de souscription (site vitrine WordPress)
PUBLIC_ORIGINS=https://www.exemple.fr,https://exemple.fr
# Paiement : stripe (production) | fake (démo)
PAYMENT_PROVIDER=stripe
# Serveur de démonstration uniquement (PAYMENT_PROVIDER=fake) : page de paiement simulée avec cartes de test
# 4242 4242 4242 4242 (acceptée) / 4000 0000 0000 0002 (refusée). Jamais avec de vrais clients.
DEMO_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Tax (TVA automatique) : activer Tax dans le tableau de bord (adresse d'origine + immatriculation France). false = sans TVA calculée par Stripe.
STRIPE_AUTOMATIC_TAX=true
STRIPE_PRICE_SOLO_MONTH=
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_EQUIPE_MONTH=
STRIPE_PRICE_EQUIPE_YEAR=
STRIPE_PRICE_CENTRE_MONTH=
STRIPE_PRICE_CENTRE_YEAR=
STRIPE_PRICE_ADDON_BANK=
STRIPE_PRICE_ADDON_MAIL_INBOX=
STRIPE_PRICE_SIGNATURE_PACK=
# Canal email système (vérification, sécurité) : smtps://user:pass@smtp.fournisseur.eu:465
SYSTEM_SMTP_URL=
SYSTEM_MAIL_FROM=Votre marque <no-reply@exemple.fr>
TERMS_VERSION=2026-10-06
TRIAL_DAYS=14
PAYMENT_GRACE_DAYS=7
# Référentiels OpenData (URL de ressource data.gouv.fr du jeu à suivre)
OPENDATA_URL_DGEFP_OF=
OPENDATA_URL_RNCP_RS=
OPENDATA_URL_MCF_OFFRE=
