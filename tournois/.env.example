# Mots de passe PostgreSQL (propriétaire du schéma / rôle applicatif soumis à la RLS)
DB_OWNER_PASSWORD=changer-moi
DB_APP_PASSWORD=changer-moi-aussi
# URL publique de l'application (liens des QR Codes et des emails)
APP_URL=https://tournois.exemple.fr
# Super administrateurs (emails séparés par des virgules)
PLATFORM_ADMINS=
# Offre attribuée aux nouveaux clubs : free | club | pro (club pendant la phase pilote, par exemple)
DEFAULT_PLAN=free
# Emails : smtp://user:pass@smtp.exemple.fr:587 (vide = journal uniquement)
SMTP_URL=
MAIL_FROM=Tournois <no-reply@exemple.fr>
# Durée des sessions (jours), validité des QR Codes individuels (jours)
SESSION_DAYS=30
PARTICIPANT_TOKEN_DAYS=30
# Contrôle des délais de confirmation des scores (secondes)
SWEEP_SECONDS=60
WEB_PORT=8090
