# Reverse proxy Caddy — sous-domaines publics vers l'app Sesame Suite.
#
# admin.sesame.technology  -> back-office hôtel (servi par l'app sur /admin)
# guest.sesame.technology  -> parcours client   (servi par l'app sur /  )
#
# Toutes les autres routes (API /wa/*, /version, assets statiques...) sont
# partagées par les deux apps et vivent au même chemin quel que soit le
# sous-domaine — seule la page d'accueil (/) est donc réécrite pour
# admin.sesame.technology ; guest.sesame.technology n'a besoin d'aucune
# réécriture puisque le parcours client est déjà servi à la racine.
#
# Caddy obtient et renouvelle automatiquement un certificat Let's Encrypt
# pour chaque domaine listé ci-dessous dès que le DNS pointe vers ce
# serveur et que les ports 80/443 sont ouverts — aucune configuration
# certbot séparée n'est nécessaire.

admin.sesame.technology {
	@root path /
	rewrite @root /admin
	reverse_proxy app:3000
}

guest.sesame.technology {
	reverse_proxy app:3000
}
