DATABASE_URL="postgresql://sesame:sesame@localhost:5432/sesame_suite?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"
DEFAULT_ENTITY_CODE="E00000001"
# Clé partagée avec le flux Power Automate qui appelle POST
# /wa/crmProspect/inboundSignal (header X-Inbound-Secret) pour signaler un
# email entrant d'un contact CRM — voir README, section "Signal d'engagement".
INBOUND_EMAIL_SECRET="change-me-in-production"
# Base publique du site (sans slash final) — nécessaire pour construire les
# liens de questionnaire envoyés par une règle d'automatisation exécutée en
# tâche de fond (pas de requête HTTP en cours pour en déduire l'hôte).
PUBLIC_BASE_URL="https://app.sesame-technology.com"
# App Azure AD (client credentials) pour lire la boîte support via
# Microsoft Graph et créer des tickets à partir des emails entrants — voir
# docs/microsoft-graph-inbound-tickets.md pour la procédure de création.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
