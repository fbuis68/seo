DATABASE_URL="postgresql://sesame:sesame@localhost:5432/sesame_suite?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"
DEFAULT_ENTITY_CODE="E00000001"
# Clé partagée avec le flux Power Automate qui appelle POST
# /wa/crmProspect/inboundSignal (header X-Inbound-Secret) pour signaler un
# email entrant d'un contact CRM — voir README, section "Signal d'engagement".
INBOUND_EMAIL_SECRET="change-me-in-production"
# Base publique du site (sans slash final) — nécessaire pour construire les
# liens de questionnaire envoyés par une règle d'automatisation exécutée en
# tâche de fond (pas de requête HTTP en cours pour en déduire l'hôte).
PUBLIC_BASE_URL="https://app.sesame-technology.com"
# Base de l'app CLIENT (checkin.html, booking.html...), sans slash final —
# distincte de PUBLIC_BASE_URL ci-dessus (admin/CRM). Sert à construire le
# lien d'autologin espace client ({{lienAutologin}}) envoyé par email.
GUEST_BASE_URL="https://guest.sesame.technology"
# App Azure AD (client credentials) pour lire la boîte support via
# Microsoft Graph et créer des tickets à partir des emails entrants — voir
# docs/microsoft-graph-inbound-tickets.md pour la procédure de création.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Assistant support IA (cas similaires, réponse suggérée, FAQ) — voir
# docs/support-ia-lot1.md. Deux fournisseurs distincts : OpenAI pour les
# embeddings (recherche sémantique) uniquement, Claude pour tout le texte
# généré. Absents ⇒ fonctionnalité désactivée (503), reste du CRM inchangé.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Identifiant Créancier SEPA (ICS) de Sesame Technology France — imprimé sur
# chaque mandat de prélèvement généré par la signature électronique "contrat
# + mandat SEPA" (routes/crmSignature.ts, requiresBankMandate). À VÉRIFIER
# avant mise en prod (relevé ci-dessous depuis le gabarit papier fourni —
# confirmez-le auprès de votre banque/GoCardless avant de vous y fier) :
GOCARDLESS_ICS="FR76169580000112333854292"

# Sauvegarde chiffrée (P0-06) : les variables BACKUP_*/DRILL_* ne vont PAS
# dans ce fichier — les scripts scripts/backup/*.sh tournent sur l'hôte
# (systemd timer), pas dans le conteneur app, et lisent leur propre fichier
# d'environnement séparé (/etc/sesame-backup.env). Voir
# docs/backup-restore.md pour la liste complète et la procédure.
