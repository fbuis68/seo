// Campagnes marketing (email/SMS) — segmentation calculée à l'envoi depuis
// la base clients (réservations + fidélité), pas de table de destinataires
// dédiée pour cette itération.
model Campaign {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel      String // email | sms
  templateKey  String?
  subject      String?
  content      String?
  audienceDesc String? // description lisible du segment ciblé
  audienceSize Int     @default(0)
  status       String  @default("sent") // draft | sent

  createdAt DateTime @default(now())
}

// Demande/contrat de souscription — panneau "Souscriptions" (back-office
// Sesame). entityId reste null tant que l'abonnement est en essai et n'a
// pas encore été activé (l'établissement n'existe pas encore en base) ;
// l'activation provisionne l'Entity + son AdminUser (cf. provisionEntity()).
model Subscription {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  crmProspect CrmProspect?

  hotelName    String
  stars        Int     @default(3)
  contactEmail String
  contactPhone String?
  pmsLabel     String?

  modules      Json  @default("[]") // string[] clés de modules souscrits
  basePrice    Float
  modulePrices Json  @default("{}") // {moduleKey: prix} — snapshot à la souscription
  monthlyTotal Float

  // Modèle tarifaire choisi à l'inscription ("forfait zéro", 20/08/2026 — cf.
  // README) : "flat" = abonnement classique (basePrice/modulePrices/
  // monthlyTotal ci-dessus font foi, comportement historique inchangé).
  // "roi_share" = pas de forfait mensuel fixe — Sesame prélève roiSharePct%
  // des économies de ménage (heures évitées × taux horaire) et du chiffre
  // d'affaires room service généré via la plateforme ; basePrice/
  // modulePrices/monthlyTotal valent alors 0 (rien n'est facturé a priori).
  // v1 : capture uniquement le choix fait à l'inscription — le moteur de
  // calcul mensuel réel (agrégation des ménages évités/commandes par
  // entité, facturation) n'est pas encore implémenté.
  pricingModel String @default("flat") // flat | roi_share
  roiSharePct  Int    @default(10) // % pris par Sesame si pricingModel="roi_share"

  paymentIbanHolder String?
  paymentIbanLast4  String?

  status      String    @default("trial") // trial | active | expired | cancelled
  trialDays   Int       @default(30)
  trialEnd    DateTime?
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Grille tarifaire globale du wizard d'inscription (ligne unique id="global").
model PricingConfig {
  id           String   @id @default("global")
  basePrice    Float    @default(49)
  trialDays    Int      @default(30)
  modulePrices Json     @default("{}") // {moduleKey: prix}
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// CRM commercial interne de Sesame — pipeline prospects/clients, distinct du
// CRM par établissement (module clientPrefs/CrmProspect gère les hôtels eux-
// mêmes en tant que comptes, pas leurs clients finaux). Réservé aux comptes
// "sesame" (cf. requireSesame). Un enregistrement est créé automatiquement
// à chaque inscription complétée via le wizard d'onboarding public.
// ─────────────────────────────────────────────────────────────────────────
model CrmProspect {
  id String @id @default(cuid())

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  subscriptionId String?      @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  nom            String
  type           String  @default("Client") // Prospect | Client — auto "Prospect" pour les arrivées onboarding/formulaire de contact
  groupe         String?
  secteur        String?
  // Identité légale — "nom" reste le nom d'usage/commercial affiché partout
  // (listes, badges, graphiques) ; ces champs sont l'identité INSEE exacte,
  // remplissables à la main ou via la recherche d'entreprises (API publique
  // recherche-entreprises.api.gouv.fr, cf. crm.html) qui les renseigne tous
  // en un clic à partir d'une raison sociale ou d'un SIRET/SIREN saisi.
  denominationSociale String?
  siret               String? // 14 chiffres (SIREN + NIC de l'établissement)
  siren               String? // 9 chiffres — 9 premiers du SIRET, gardé distinct : retourné tel quel par l'API
  adresse        String? // adresse postale (numéro + voie) — ville reste un champ séparé
  ville          String?
  etoiles        String?
  danger         String  @default("Modéré") // Bon client | Modéré | Élevé !!
  potentiel      Int     @default(0) // 0-3
  contrat        String  @default("non") // non | oui | en cours
  modules        Int     @default(0)
  // Type de module d'accès installé — indépendants l'un de l'autre (un
  // client peut avoir plusieurs cases cochées, ex : en transition de l'un
  // vers l'autre). Backfillés le 24/08/2026 depuis la colonne "Type Module"
  // de l'audit (AUDIT_CLIENTS_SESAME_2025.xlsx) — jusque-là ces champs
  // n'avaient jamais été renseignés pour la quasi-totalité des fiches
  // importées (ajoutés après l'import initial, sans backfill), d'où un
  // décompte "Type de module installé" très en dessous de la réalité.
  moduleSesame Boolean @default(false)
  moduleTtlock Boolean @default(false)
  moduleOneway Boolean @default(false) // 3e type d'accès trouvé dans l'audit, absent du modèle jusqu'ici
  nbAcces        Int     @default(0) // nombre de points d'accès (portes/serrures) installés chez le client
  pms            String?
  priorite       Int     @default(0) // 0-3
  appel          String? // date libre ("16/10/25") ou "Ne pas appeler"
  referent       String?
  email          String?
  tel            String?
  site           String?
  nfc            Int     @default(0) // % d'usage — les 4 se totalisent à 100% par fiche
  qr             Int     @default(0)
  mobile         Int     @default(0)
  code           Int     @default(0)
  webApp         Boolean @default(false)
  mobileV2       Boolean @default(false)
  checkin        Boolean @default(false)
  livret         Boolean @default(false)
  gestionDemande Boolean @default(false)
  offline        Boolean @default(false)
  // Parcours activés côté client final — par défaut selon le secteur
  // (cf. sectorGroupFor() côté seed/front), éditables ensuite par fiche.
  onbChoixChambres Boolean @default(false) // Onboarding : choix de la chambre
  onbOccupant      Boolean @default(false) // Onboarding : déclaration des occupants
  onbIdentite      Boolean @default(false) // Onboarding : vérification d'identité
  onbMenage        Boolean @default(false) // Onboarding : préférences ménage
  espBoutique      Boolean @default(false) // Espace client : boutique / room service
  espPoint         Boolean @default(false) // Espace client : solde de points fidélité
  espEvenement     Boolean @default(false) // Espace client : évènements/offres de l'établissement
  messagerie     String  @default("Noreply") // Noreply | Client
  note           String?

  // Portefeuille financier — MRR importé du fichier de trésorerie (montant
  // mensuel récurrent, quand la fiche a pu être rapprochée par nom) ; signé
  // et prévisionnel sont saisis à la main dans le tableau "Portefeuille"
  // (public/crm.html) pour permettre au commercial d'additionner ses trois
  // compteurs sans dépendre d'un import.
  mrr          Float? // € / mois, récurrent
  signe        Float? // € — montant signé (ponctuel ou engagé), saisie manuelle
  previsionnel Float? // € — montant prévisionnel/pipeline, saisie manuelle

  // Signal d'engagement entrant — alimenté par POST /wa/crmProspect/inboundSignal
  // (flux Power Automate générique sur les boîtes partagées fbuis@/jtlod@
  // sesame-technology.com, cf. README) : incrémenté à chaque email reçu d'une
  // adresse qui correspond à cette fiche, sans jamais stocker le contenu.
  inboundReplyCount  Int       @default(0)
  lastInboundReplyAt DateTime?

  // Commercial Sesame en charge de ce client/prospect (compte role="sesame").
  commercialId String?
  commercial   AdminUser? @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  deals CrmDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities CrmActivity[]
  tickets    CrmTicket[]
}

// ─────────────────────────────────────────────────────────────────────────
// Trésorerie prévisionnelle — modèle simplifié (20/08/2026, remplace le
// détail par client/prospect du mock-up du 19/08/2026 : plus de "Signé"
// (par client) ni de "Pipeline pondéré" (par prospect), juste des lignes
// récurrentes génériques. Le MRR reste porté par CrmProspect.mrr côté
// fiche/Portefeuille (inchangé) mais n'alimente plus ce panneau.
//   - "revenu"       : ligne d'encaissement récurrent — fréquence mensuelle,
//                      trimestrielle ou ponctuelle (cf. `frequence`)
//   - "depense"      : ligne de dépense récurrente — fréquence mensuelle ou
//                      ponctuelle uniquement (pas de trimestriel)
//   - "solde_depart" : une ligne unique par année portant le solde de
//                      trésorerie (frequence toujours null, `mois` donne le
//                      mois auquel ce solde est constaté — défaut janvier)
// `mois` (0-11) donne, selon `frequence` : le mois unique où la ligne tombe
// (ponctuel), le mois de départ du cycle trimestriel (trimestriel — répétée
// tous les 3 mois à partir de là), ou est ignoré (mensuel : tous les mois).
model CrmCashLine {
  id        String  @id @default(cuid())
  annee     Int     @default(2026)
  kind      String // revenu | depense | solde_depart
  label     String
  montant   Float
  frequence String? // mensuel | trimestriel | ponctuel — revenu/depense uniquement
  mois      Int? // 0-11 ; sémantique dépend de frequence (cf. ci-dessus) ; pour solde_depart, mois du solde constaté

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bascule "saisie globale / détaillée" par catégorie (revenu, dépense) et
// par année — une ligne unique par année. En mode "detail", le total de la
// catégorie est calculé automatiquement à partir des CrmCashLine
// correspondantes ; en mode "global", un seul montant/fréquence saisis ici
// font foi pour la projection, et les lignes détaillées (s'il y en a)
// restent visibles en lecture seule pour vérifier que leur somme est
// cohérente avec le chiffre global.
model CrmCashSettings {
  id    String @id @default(cuid())
  annee Int    @unique

  revenuMode      String  @default("detail") // global | detail
  revenuMontant   Float   @default(0)
  revenuFrequence String  @default("mensuel") // mensuel | trimestriel | ponctuel
  revenuMois      Int?

  depenseMode      String  @default("detail")
  depenseMontant   Float   @default(0)
  depenseFrequence String  @default("mensuel") // mensuel | ponctuel
  depenseMois      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Module "Gestion des affaires" — pipeline commercial greffé sur le CRM
// Sesame (18/08/2026). Une "affaire" (deal) représente une opportunité de
// vente pour un client/prospect donné ; plusieurs affaires possibles par
// fiche (upsell, renouvellement...). Les devis (CrmQuote) sont rattachés à
// une affaire, pas directement à la fiche, pour garder l'historique des
// versions/négociations d'une même opportunité.
// ─────────────────────────────────────────────────────────────────────────
model CrmDeal {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  commercialId String?
  commercial   AdminUser? @relation("DealCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  title       String
  stage       String    @default("Nouveau") // Nouveau | Qualification | Devis envoyé | Négociation | Gagné | Perdu
  amount      Float     @default(0) // valeur mensuelle estimée (MRR) de l'affaire
  probability Int       @default(20) // 0-100 — pondère amount ET montantPonctuel
  closeDate   DateTime? // date de clôture prévue/réelle selon l'étape
  lostReason  String?

  // Montant ponctuel (one-shot, distinct du MRR "amount" ci-dessus — ex.
  // frais de mise en service, vente d'équipement), mois (0-11) ET année où
  // il doit être encaissé. Pondéré par `probability` et reporté
  // automatiquement sur le panneau Trésorerie (catégorie Encaissement, cf.
  // crm.html trDealsPipelineFor()) — ignoré si l'affaire est au stade
  // "Perdu". `anneeEncaissement` ajouté le 25/08/2026 : sans elle,
  // `moisEncaissement` seul (ex. "Octobre") ne distingue pas Octobre 2026
  // d'Octobre 2027, et deux affaires de deux années différentes se
  // retrouvaient additionnées dans le même mois de la Trésorerie affichée —
  // fiches déjà en base avant cet ajout traitées comme année civile en
  // cours au moment du calcul (cf. dealEncaissementYear()).
  montantPonctuel  Float?
  moisEncaissement Int?
  anneeEncaissement Int?

  quotes CrmQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Devis — lignes libres en JSON pour rester "souple" (catalogue de modules
// Sesame ET lignes personnalisées mélangés) tout en restant "automatique"
// (le constructeur de devis pré-remplit les lignes de modules depuis le même
// catalogue de prix que le wizard d'inscription, cf. ONBOARDING_MODULES /
// PricingConfig — une seule source de vérité tarifaire dans toute l'app).
model CrmQuote {
  id     String  @id @default(cuid())
  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  number String @unique // ex: DEV-2026-0001
  status String @default("brouillon") // brouillon | envoyé | accepté | refusé

  lines       Json    @default("[]") // [{label, description?, qty, unitPrice, recurring:bool}] — description = sous-texte verbeux affiché sous le libellé, comme sur les devis Sesame réels
  discountPct Float   @default(0)
  notes       String?
  sentAt      DateTime?

  // Signature électronique simple (18/08/2026) — signToken donne accès à la
  // page publique de signature (public/devis-signature.html), sans compte
  // CRM. Volontairement PAS une signature électronique qualifiée (eIDAS) :
  // capture nom saisi + tracé + horodatage/IP à titre de preuve de
  // consentement, à la manière d'un "clic pour accepter" plutôt qu'une
  // signature certifiée par un tiers de confiance (Yousign/DocuSign...).
  signToken String?             @unique
  signature CrmQuoteSignature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmQuoteSignature {
  id      String   @id @default(cuid())
  quoteId String   @unique
  quote   CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  signerName       String
  signerEmail      String?
  signatureDataUrl String @db.Text // image PNG (canvas) encodée en base64
  ip               String?
  userAgent        String?

  signedAt DateTime @default(now())
}

// Catalogue produits interne Sesame (18/08/2026) — distinct du catalogue
// "modules" SaaS (ONBOARDING_MODULES/PricingConfig, utilisé pour le pricing
// des souscriptions) : ici du matériel et des prestations facturables au
// devis (contrôles d'accès, gateway, formation...), avec un indicateur
// stockable/non-stockable en prévision d'une gestion de stock à venir —
// stockQty existe déjà dans le modèle mais n'est lu/écrit nulle part pour
// l'instant, volontairement, tant que cette gestion de stock n'est pas
// construite.
model CrmProduct {
  id          String  @id @default(cuid())
  sku         String?
  label       String
  description String? // sous-texte verbeux réutilisé sur les lignes de devis
  unitPrice   Float   @default(0)
  recurring   Boolean @default(false) // mensuel (true) ou ponctuel (false)
  stockable   Boolean @default(false)
  stockQty    Int? // réservé à la future gestion de stock — non utilisé pour l'instant
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modèles de devis récurrents (18/08/2026) — pour gagner le temps de
// ressaisie sur des devis au contenu verbeux et répétitif : un modèle porte
// déjà tous les libellés/descriptions/prix, il ne reste qu'à ajuster les
// quantités à la marge lors de la création d'un devis à partir de ce
// modèle (cf. POST /wa/crmQuote/create avec templateId).
model CrmQuoteTemplate {
  id    String @id @default(cuid())
  name  String
  lines Json   @default("[]") // même forme que CrmQuote.lines
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmActivity {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type         String // Appel | Email | Visite | Proposition | Relance | Note interne | Autre
  text         String
  authorName   String?
  activityDate DateTime?
  done         Boolean   @default(false)

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Module Tickets (support) — 19/08/2026. Un client (contact hôtelier déjà
// suivi au CRM, ou nouveau retrouvé/créé par email comme le formulaire de
// contact) ouvre un incident depuis le widget public (public/support.html) ;
// l'équipe Sesame le qualifie (statut/priorité/type/agent) et y répond
// depuis la fiche — réponse envoyée par email réel au contact, note interne
// jamais envoyée. `publicToken` donne au client un lien permanent vers SON
// ticket pour le compléter (note + image) sans repasser par une nouvelle
// ouverture, à la manière de CrmQuote.signToken pour la signature de devis.
// ─────────────────────────────────────────────────────────────────────────
model CrmTicket {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AdminUser? @relation("TicketAgent", fields: [agentId], references: [id], onDelete: SetNull)

  subject      String
  status       String  @default("En attente") // En attente | En cours | Attente client | Résolu | Fermé
  priority     String  @default("Normale") // Basse | Normale | Haute | Urgente
  type         String? // Incident technique | Question | Demande | Facturation | Autre
  tags         Json    @default("[]") // string[]
  contactEmail String // qui a ouvert le ticket (peut différer du référent de la fiche)
  contactName  String?
  publicToken  String  @unique @default(cuid())

  messages CrmTicketMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
}

model CrmTicketMessage {
  id       String    @id @default(cuid())
  ticketId String
  ticket   CrmTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType  String // client | agent
  authorName  String?
  kind        String // reply (envoyé par email au client si authorType=agent) | note (interne, jamais envoyée)
  body        String @db.Text
  attachments Json   @default("[]") // string[] data URI — même convention que Room.photos

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Envoi d'email générique — un serveur SMTP sortant + des modèles, réutilisés
// tels quels par le module CRM (entityId=null, portée Sesame) et par le
// back-office de chaque hôtel (entityId=<hôtel>, ses propres modèles/envois).
// @unique sur entityId empêche deux configs pour un même hôtel ; côté null
// (portée globale CRM), PostgreSQL traite chaque NULL comme distinct — la
// route applique donc toujours un "findFirst puis create/update" plutôt que
// de compter sur la contrainte pour ce cas précis.
// ─────────────────────────────────────────────────────────────────────────
model SmtpConfig {
  id       String  @id @default(cuid())
  entityId String? @unique
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  host     String
  port     Int     @default(587)
  secure   Boolean @default(false) // true = SMTPS (465), false = STARTTLS/plain (587/25)
  username String
  password String
  fromName  String?
  fromEmail String

  // Adresse dédiée aux réponses de tickets support (module Tickets,
  // 19/08/2026) — distincte de fromEmail/fromName pour que les échanges
  // support ("L'équipe Support Sesame") ne partent pas sous l'identité
  // générique utilisée pour les autres emails CRM. Retombe sur
  // fromEmail/fromName si non renseignée (cf. ticketFromHeader()).
  supportFromEmail String?
  supportFromName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modèle de message multi-canal — un seul mécanisme de gabarit ({{variable}})
// partagé par l'email (subject+bodyHtml), le SMS et le WhatsApp (bodyHtml
// sert alors de texte brut, subject ignoré). C'est cette convergence de
// modèles, combinée à ChannelConfig et sendMessage() (src/lib/messaging.ts),
// qui permet aux règles d'automatisation de cibler indifféremment l'un des
// trois canaux pour un même déclencheur métier.
model MessageTemplate {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel  String  @default("email") // email | sms | whatsapp
  key      String // slug interne, ex: "prospect-relance" — cible de sendMessage()
  name     String // libellé affiché dans le sélecteur de modèle
  subject  String // email uniquement ; supporte {{variable}}
  bodyHtml String // email : HTML ; sms/whatsapp : texte brut — supporte {{variable}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, channel, key])
}

// Identifiants Twilio pour SMS et WhatsApp — même principe de portée que
// SmtpConfig (entityId=null : CRM/Sesame ; entityId=<hôtel> : back-office).
// Un provider unique (Twilio) couvre les deux canaux avec un seul compte,
// ce qui est la brique qui permet la convergence email/SMS/WhatsApp.
model ChannelConfig {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel    String // sms | whatsapp
  provider   String  @default("twilio") // twilio | smspartner (SMS uniquement — pas de WhatsApp chez ce partenaire)
  accountSid String?
  authToken  String?
  fromNumber String? // numéro Twilio (SMS/WhatsApp) ou nom d'émetteur DocPartner/SMSPartner (SMS, 3-11 car.)
  apiKey     String? // clé API DocPartner/SMSPartner.fr — auth par clé unique (provider=smspartner)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, channel])
}

// ─────────────────────────────────────────────────────────────────────────
// Règles d'automatisation — déclenchées soit immédiatement par un événement
// métier (fireTrigger(), appelé depuis les routes concernées), soit par un
// balayage périodique (automationScheduler.ts) pour les déclencheurs relatifs
// à une date (avant/après séjour) ou récurrents (newsletter). AutomationRuleLog
// évite les doublons d'envoi : une ligne par (règle, cible) déjà notifiée.
// ─────────────────────────────────────────────────────────────────────────
model AutomationRule {
  id       String  @id @default(cuid())
  entityId String? // null = portée CRM/Sesame
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name    String
  trigger String // clé du catalogue TRIGGERS (src/lib/automation.ts), ex: "booking.created"
  enabled Boolean @default(true)

  timingMode  String  @default("immediate") // immediate | before | after | recurring
  offsetValue Int? // ex: 1 (timingMode="before"|"after")
  offsetUnit  String? // minutes | hours | days
  recurrence  String? // daily | weekly | monthly (timingMode="recurring")
  atTime      String? // "HH:mm" (timingMode="recurring")
  dayOfWeek   Int? // 0(dim)-6, recurrence="weekly"
  dayOfMonth  Int? // 1-31, recurrence="monthly"

  channel     String // email | sms | whatsapp
  templateKey String

  // Destinataire : par défaut celui de l'événement (client de la réservation,
  // prospect du CRM…) ; "custom" permet de cibler une adresse/numéro fixe à
  // la place — utile pour notifier l'équipe (ex: réception) plutôt que le
  // client sur "order.created".
  recipientMode     String  @default("event") // event | custom
  recipientOverride String? // email ou numéro selon channel, requis si recipientMode="custom"

  // Nom d'expéditeur affiché pour cette règle (email uniquement) — remplace
  // celui de la config SMTP de la portée si renseigné, sinon comportement
  // inchangé (nom de la config).
  senderName String?

  audienceFilter Json? // segment cible pour les règles sans record source unique (ex: crm.newsletter)

  lastRunAt DateTime?

  // Visibilité des échecs — sans ça, un envoi qui échoue (SMTP mal
  // configuré, modèle introuvable…) n'était visible que dans les logs
  // serveur : la règle semblait "ne rien faire" sans qu'on sache pourquoi.
  // Effacé à la prochaine réussite (n'affiche jamais un échec périmé).
  lastError   String?
  lastErrorAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AutomationRuleLog[]
}

model AutomationRuleLog {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  targetType String // "booking" | "order" | "crmProspect" | "period" (newsletter)…
  targetId   String
  sentAt     DateTime       @default(now())

  @@unique([ruleId, targetType, targetId])
}
