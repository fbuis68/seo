// Sesame Technology — Suite Hôtelière
// Schéma PostgreSQL — modèle inspiré des 7 tables "sesamelite" décrites dans
// la documentation technique, étendu aux entités nécessaires au parcours
// client complet (chambres, réservations, catalogue boutique, fidélité,
// livret digital, ménage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-tenant : un Hôtel = une Entity (isolation par entityId partout,
// principe 4 du framework fmk documenté).
// ─────────────────────────────────────────────────────────────────────────
model Entity {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  config            EntityModuleConfig?
  rooms             Room[]
  bookings          Booking[]
  products          Product[]
  orders            Order[]
  taxeRecords       TaxeSejourRecord[]
  clientPrefs       ClientPrefs[]
  loyaltyAccounts   LoyaltyAccount[]
  livretSections    LivretSection[]
  housekeepingTasks HousekeepingTask[]
  housekeepingStaff HousekeepingStaff[]
  adminUsers        AdminUser[]
  campaigns         Campaign[]
  subscriptions     Subscription[]
  bookingSource     BookingSourceConfig?
  lockerSource      LockerSourceConfig?
  crmProspects      CrmProspect[]
  smtpConfig        SmtpConfig?
  messageTemplates  MessageTemplate[]
  channelConfigs    ChannelConfig[]
  automationRules   AutomationRule[]
}

// Groupe d'établissements (ex : chaîne hôtelière) — gestion réservée aux
// comptes Sesame. loyaltyMode/ecoMode déterminent si la politique
// correspondante est centralisée (un seul réglage partagé, points de
// fidélité cumulés sur tout le groupe) ou seulement "copiée" au moment du
// rattachement puis gérée indépendamment par chaque établissement ensuite.
model Group {
  id   String @id @default(cuid())
  code String @unique
  name String

  loyaltyMode String @default("independent") // centralized | independent
  ecoMode     String @default("independent") // centralized | independent

  // Utilisés uniquement quand le mode correspondant est "centralized" —
  // mêmes formes que EntityModuleConfig.gains / .loyaltyTiers et le
  // sous-ensemble de champs éco (eauMenage, eauServ, co2Factor, freqOpts,
  // exoEnf, reducAdos, exoHand).
  sharedGains        Json?
  sharedLoyaltyTiers Json?
  sharedEco          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities        Entity[]
  loyaltyAccounts LoyaltyAccount[]
}

// Compte back-office (panneau admin). role="hotel" : géranté par un seul
// établissement (son entityId). role="sesame" : compte Sesame, rattaché à
// une entité technique interne ("Sesame HQ") mais peut agir sur n'importe
// quel établissement via entityCode (cf. resolveEntity côté serveur) —
// c'est le compte qui crée/gère les autres établissements.
model AdminUser {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  name         String?
  role         String  @default("hotel") // sesame | hotel | housekeeping (app tablette menage.html, cf. housekeepingScope.ts)
  // Rôle fonctionnel au sein de l'équipe Sesame — uniquement pertinent pour
  // role="sesame" (un compte hôtel n'a pas de crmRole). "admin" = accès
  // complet au CRM interne (dont la gestion des utilisateurs CRM eux-mêmes,
  // cf. requireCrmAdmin) ; "commercial" = accès standard.
  crmRole String  @default("commercial")
  active  Boolean @default(true) // désactivation (départ, etc.) sans perdre l'historique — pas de suppression physique

  resetTokens PasswordResetToken[]

  // "Commercial" assigné — uniquement pertinent pour les comptes role="sesame"
  // (l'équipe interne), cf. GET /wa/commercial/list.
  crmProspectsAsCommercial CrmProspect[] @relation("ProspectCommercial")
  crmDealsAsCommercial     CrmDeal[]     @relation("DealCommercial")
  crmTicketsAsAgent        CrmTicket[]   @relation("TicketAgent")

  createdAt DateTime @default(now())
}

// Mot de passe oublié — token à usage unique, seul son hash est stocké (le
// token en clair ne transite que dans l'email envoyé, jamais en base ni
// dans les logs), avec expiration courte (1h, imposée côté application).
model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Équivalent de entity_module_config (35 colonnes dans la doc) — regroupé en
// colonnes JSON typées côté TypeScript pour rester proche de la structure
// CFG consommée telle quelle par le front.
model EntityModuleConfig {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  hotelName   String
  hotelSlogan String?
  hotelAddr   String?
  hotelEmail  String?
  stars       Int     @default(3)

  colors     Json // {primary, primaryLight, accent, headerBg, headerText, bg, cardBg, border, text, btnNav}
  radius     Int     @default(14)
  radiusBtn  Int     @default(8)
  shadow     Boolean @default(true)
  fontTitle  String  @default("'Fraunces',serif")
  fontBody   String  @default("'Sora',sans-serif")
  darkH      Boolean @default(true)
  logoMain   String?
  logoIcon   String?
  msgEco     String?
  msgWelcome String?
  btnLabel   String  @default("Continuer")
  ptsLabel   String  @default("Sesame Points")
  progName   String? @default("Mon programme éco")
  lang       String  @default("fr")
  currency   String  @default("EUR")
  // Fuseau horaire de l'établissement (identifiant IANA, ex. "Europe/Paris",
  // "America/Guadeloupe") — sert de référence pour tout ce qui dépend du
  // "jour" ou de "l'heure actuelle" à l'hôtel plutôt que sur le serveur ou
  // le fuseau du navigateur : arrivées du jour, plages KPI, planning
  // ménage, statut "en cours de séjour" côté client, et le moteur
  // d'automatisation (délais avant/après séjour). Cf. src/lib/timezone.ts.
  timezone   String  @default("Europe/Paris")

  tarifs    Json // number[5] — tarif taxe de séjour par catégorie d'étoiles
  exoEnf    Boolean @default(true)
  reducAdos Boolean @default(true)
  exoHand   Boolean @default(false)

  eauMenage Int   @default(15)
  eauServ   Int   @default(40)
  co2Factor Float @default(0.0003)
  freqOpts  Json // number[] fréquences ménage proposées

  gains          Json // {points:{...}, reduction:{...}, produit:{...}, financier:{...}}
  checkinModules Json // {room:{active,mandatory}, taxe:{...}, kyc:{...}, eco:{...}, boutique:{...}, roomservice:{...}, rewards:{...}}
  rewardCatalog  Json?
  loyaltyTiers   Json? // {gold, premium, perks:{Standard:[],Gold:[],Premium:[]}}

  hotelPlan    String? // image du plan (base64 ou URL)
  roomTags     Json?
  accessPoints Json?
  kpi          Json? // {minPerClean, minPerTowel, hourlyRate, annualStays, checkinMin, checkinAdoption}

  updatedAt DateTime @updatedAt
}

// Équivalent "facility" (chambre)
model Room {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  code        String
  name        String
  floor       Int     @default(0)
  surface     Float?
  category    String?
  type        String?
  capacity    Int?
  rate        Float?
  description String?
  pmr         Boolean @default(false)
  nosmoking   Boolean @default(true)
  connected   Boolean @default(false)
  tags        Json // string[]
  photos      Json // string[]
  available   Boolean @default(true)
  x           Float? // position sur le plan (coordonnées 540x380)
  y           Float?
  // Exclut cet accès du parcours ménage (planning d'interventions, statut
  // de propreté, appli tablette du personnel) — utile pour les accès qui
  // n'en ont pas besoin (ex : casiers Mon Casier Frais, cf. type="casier").
  // N'affecte pas la disponibilité générale de l'accès (réservations,
  // panneau "Gestion des Accès").
  housekeepingExempt Boolean @default(false)

  createdAt DateTime @default(now())

  bookings           Booking[]
  housekeepingStatus RoomHousekeepingStatus?

  @@unique([entityId, code])
}

model Booking {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  code             String
  personEmail      String
  personFirstname  String
  personLastname   String
  personPhone      String?
  startDate        DateTime
  endDate          DateTime
  roomId           String?
  room             Room?    @relation(fields: [roomId], references: [id])
  facilityCode     String? // dénormalisé — code chambre au moment de la réservation
  facilityName     String?
  status           String   @default("confirmed") // confirmed | checkin_done | completed | cancelled
  // Champ à part entière issu de la source externe (ex : "typeCode/typeId/
  // type" de l'API Sesame Technology) — n'est PAS dérivé de Room.category :
  // Sesame distingue le type de réservation du type de chambre occupée.
  // Importé via fieldMapping.bookingType, modifiable depuis le panneau
  // Réservations, répercuté à la source externe via
  // BookingSourceConfig.updateBookingTypeParam (cf. pushBookingUpdate).
  bookingType      String?
  otaId            String?
  checkinDone      Boolean  @default(false)
  selectedRoomCode String? // chambre choisie à l'étape 2 (peut différer de facilityCode)
  importedFrom     String? // nom de la source si créée par le connecteur externe (cf. BookingSourceConfig), sinon null
  // Casiers Mon Casier Frais actuellement associés à cette réservation,
  // accumulés au fil des commandes contenant un article "casier" —
  // [{numberOnModule, pickupCode, orderId}]. Ajouté à la réservation dès
  // qu'une commande obtient un casier (cf. reserveLockersForOrder dans
  // roomservice.ts /roomservice/create), retiré si la commande
  // correspondante est ensuite annulée (/roomservice/update).
  lockerAccess Json?

  // Encodage de cartes/badges NFC pour cette réservation (panneau
  // "Réservations", écran de détail — cf. BookingSourceConfig.nfcEndpointPath).
  // Nombre cumulé de cartes encodées avec succès pour cette réservation ;
  // 0 tant qu'aucun encodage n'a été fait ou que le connecteur ne renvoie pas
  // de décompte exploitable.
  nfcCount     Int       @default(0)
  nfcEncodedAt DateTime? // dernier encodage réussi

  // Nombre cumulé d'ouvertures de porte à distance réussies pour cette
  // réservation (cf. lib/bookingSource.ts openDoor) — 0 tant qu'aucune
  // ouverture réelle n'a été faite (les ouvertures en mode simulation, sans
  // connecteur configuré, ne sont pas comptées ici).
  doorOpenCount    Int       @default(0)
  doorLastOpenedAt DateTime? // dernière ouverture réelle réussie

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  occupants   Occupant[]
  taxeRecords TaxeSejourRecord[]
  kycRecords  KycRecord[]
  orders      Order[]

  @@unique([entityId, code])
  @@index([personEmail])
}

// Connecteur générique de réservations externes — permet de récupérer les
// réservations d'un PMS/système tiers quelconque (pas seulement un client
// Sesame) via une API REST/JSON dont la forme est décrite par fieldMapping
// (chemins "a.b.c" vers les champs Booking). Un connecteur par établissement.
model BookingSourceConfig {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  enabled      Boolean @default(false)
  sourceName   String? // libellé libre (ex: "Mews", "Opera", "PMS interne")
  // Modèle de connecteur appliqué côté interface (panneau "Intégration
  // réservations") — purement informatif pour l'UI (savoir quelle section
  // "identifiants" afficher et quels réglages techniques pré-remplir/masquer
  // par défaut) : none | sesame | mews | opera | thais | lodgify | cloudbeds
  // | guesty | hostaway | apaleo | hostfully | hostex | rmscloud |
  // sequoiasoft | misterbooking. Le reste des champs ci-dessous reste la
  // seule source de vérité utilisée par le connecteur.
  presetId     String? @default("none")
  baseUrl      String?
  endpointPath String? // ex: "/v1/bookings" — concaténé à baseUrl
  // La plupart des API répondent à un simple GET, mais certaines (ex : API
  // Sesame Technology, /wa/booking/list) exigent un POST avec un corps
  // application/x-www-form-urlencoded — souvent juste de la pagination
  // (start/limit). endpointBodyParams n'est envoyé que si endpointMethod="POST".
  // endpointBodyFormat détermine l'encodage du corps POST : "form"
  // (application/x-www-form-urlencoded, ex: Sesame) ou "json" (corps JSON —
  // ex: API Mews, dont l'authentification par ClientToken/AccessToken se
  // fait dans le corps de chaque appel plutôt qu'un en-tête ou un jeton).
  endpointMethod     String? @default("GET") // GET | POST
  endpointBodyFormat String? @default("form") // form | json
  endpointBodyParams Json? // ex: {"start":"0","limit":"1000"}

  authType          String  @default("none") // none | apiKey | bearer | basic | login
  authApiKeyHeader  String? // ex: "X-API-Key"
  authApiKeyValue   String?
  authBearerToken   String?
  authBasicUser     String?
  authBasicPassword String?

  // authType="login" — flux en deux temps (ex : API Sesame Technology) :
  // POST identifiants vers loginPath, extraction du token via
  // loginTokenPath, puis ce token est envoyé en en-tête sur chaque appel
  // suivant. Relancé à chaque synchronisation (pas de cache de token).
  // loginPath accepte aussi une URL absolue (http/https) — nécessaire quand
  // le serveur d'authentification est sur un hôte différent de baseUrl (ex :
  // Apaleo, identity.apaleo.com vs api.apaleo.com) ; sinon concaténé à
  // baseUrl comme les autres chemins de ce connecteur.
  loginPath            String? // ex: "/ws/login/login" — concaténé à baseUrl, ou URL absolue
  loginEmail           String?
  loginPassword        String?
  loginEmailField      String? @default("login") // nom du champ identifiant (body ou query selon loginEmailLocation)
  loginPasswordField   String? @default("password") // nom du champ secret
  loginEmailLocation   String? @default("body") // query | body
  // Encodage du corps de la requête de connexion — "json" (défaut, ex : API
  // Sesame Technology) ou "form" (application/x-www-form-urlencoded, ex :
  // OAuth2 client_credentials — Guesty, Hostaway, Apaleo).
  loginBodyFormat      String? @default("json") // json | form
  // Où passer loginEmail/loginPassword sur l'appel de connexion — "body"
  // (défaut, champs loginEmailField/loginPasswordField) ou "basicHeader"
  // (Authorization: Basic base64(email:password) — ex : Apaleo, dont
  // l'échange de token OAuth2 authentifie le client par Basic plutôt que
  // par des champs dans le corps).
  loginCredentialsIn   String? @default("body") // body | basicHeader
  loginTokenPath       String? // dot-path du token — dans la réponse complète, ou dans le profil sélectionné ci-dessous si loginProfileListPath est renseigné (ex: "token")
  loginTokenHeaderName String? @default("Authorization")
  loginTokenPrefix     String? // ex: "Bearer " — laisser vide pour envoyer le token brut
  // Optionnel — quand la réponse de connexion contient un tableau avec un
  // profil par établissement (ex : API Sesame Technology, un même compte a
  // accès à plusieurs hôtels), ces 3 champs retrouvent le bon profil au lieu
  // de dépendre de sa position dans le tableau. loginTokenPath s'applique
  // alors au profil trouvé, pas à la réponse entière.
  loginProfileListPath   String? // dot-path du tableau de profils (ex: "data.profiles")
  loginProfileMatchField String? // nom du champ à comparer dans chaque profil (ex: "entityCode")
  loginProfileMatchValue String? // valeur recherchée (ex: "CHURCHILL")
  // Filtre de sécurité inter-établissements — certaines API "login" à
  // profils multiples (ex : Sesame Technology) n'appliquent pas de
  // cloisonnement strict par profil sur tous leurs endpoints : le token
  // authentifie le COMPTE, pas nécessairement l'établissement sélectionné
  // ci-dessus, et peut renvoyer des données d'autres établissements
  // accessibles par ce même compte (confirmé en pratique sur
  // /wa/booking/list, ex : établissement "Deer Forest" ayant reçu des
  // réservations de "Le Victor" — l'admin n'avait jamais ouvert la section
  // "réglages techniques avancés" où vivait ce filtre quand il était
  // optionnel, d'où la fuite passée inaperçue). ACTIVÉ PAR DÉFAUT dès qu'un
  // tableau de profils est configuré (loginProfileListPath/MatchField/
  // MatchValue) — resultEntityField/resultEntityProfileField valent alors
  // "entityId" si laissés vides, plutôt que de désactiver silencieusement le
  // filtrage. Seuls les éléments dont resultEntityField (dot-path dans
  // chaque réservation/chambre reçue) correspondent à la valeur trouvée au
  // chemin resultEntityProfileField dans le profil sélectionné sont
  // conservés. Si la valeur ne peut pas être extraite du profil, la
  // synchronisation échoue explicitement plutôt que d'importer sans filtrer
  // (cf. bookingSource.ts, performLogin) — sauf si skipEntityFilter est activé.
  resultEntityField String?
  // Dot-path DANS LE PROFIL sélectionné pointant vers la valeur à comparer à
  // resultEntityField. Peut différer selon l'API (ex: "id", "hotelId",
  // "propertyId" au lieu de "entityId").
  resultEntityProfileField String?
  // Échappatoire explicite pour les rares sources "login" à profils
  // multiples déjà correctement cloisonnées par l'API elle-même, où ce
  // filtre ne ferait que bloquer inutilement la synchronisation. Laisser à
  // false dans tous les autres cas — le risque d'une fuite de données
  // clients entre établissements est plus grave qu'une synchronisation
  // bloquée par erreur (visible et corrigeable immédiatement).
  skipEntityFilter Boolean @default(false)
  // Champ optionnel supplémentaire envoyé dans le corps de connexion, en
  // plus de l'email et du mot de passe — ex: certains systèmes multi-comptes
  // exigent un identifiant de client/groupe ("client": "monGroupe"). Conservé
  // pour compatibilité — préférer loginExtraParams pour plusieurs champs.
  loginExtraField String?
  loginExtraValue String?
  // Champs statiques supplémentaires envoyés dans le corps de connexion —
  // {clé: valeur} — ex : OAuth2 client_credentials exige souvent
  // grant_type=client_credentials (+ scope=xxx) en plus de l'identifiant/
  // secret déjà portés par loginEmail/loginPassword (Guesty, Hostaway,
  // Apaleo). Fusionné avec loginExtraField/loginExtraValue s'il est aussi
  // renseigné.
  loginExtraParams Json?

  // Chemin (dot-path) vers le tableau de réservations dans la réponse JSON —
  // vide/null si la réponse EST déjà le tableau.
  responseListPath String?
  // {code, personEmail, personFirstname, personLastname, personPhone,
  //  startDate, endDate, facilityCode, status} -> chemin dot-path dans
  // chaque élément du tableau (ex: {"code":"id","personEmail":"guest.email"}).
  fieldMapping     Json?

  // Chambres / espaces (facilities) — même principe que les réservations
  // ci-dessus, sur un endpoint séparé (même connexion/auth). Les importer
  // avec les codes exacts de la source externe permet ensuite au mapping
  // "facilityCode" des réservations de retrouver la bonne chambre.
  facilityEndpointPath     String? // ex: "/ws/facility/list" — concaténé à baseUrl
  facilityEndpointMethod     String? @default("GET") // GET | POST — cf. endpointMethod
  facilityEndpointBodyFormat String? @default("form") // form | json — cf. endpointBodyFormat
  facilityEndpointBodyParams Json?
  facilityResponseListPath String?
  // {code, name, floor, category, capacity, surface} -> chemin dot-path.
  facilityFieldMapping     Json?

  // Encodage NFC (panneau "Réservations" → détail d'une réservation, bouton
  // "Encoder NFC") — même connexion/auth que ci-dessus, sur un endpoint
  // séparé qui prend UNE réservation en paramètre (pas une liste) et
  // déclenche l'encodage d'une carte/badge côté source externe (ex : API
  // Sesame Technology, si elle expose bien un tel endpoint — à confirmer/
  // capturer depuis le produit réel avant de configurer ces champs). Inerte
  // tant que nfcEndpointPath est vide : le bouton "Encoder NFC" échoue alors
  // avec un message explicite plutôt que d'appeler une URL non configurée.
  nfcEndpointPath       String? // ex: "/ws/nfc/encode" — concaténé à baseUrl
  nfcEndpointMethod     String? @default("POST") // GET | POST
  nfcEndpointBodyFormat String? @default("json") // form | json
  // Paramètres statiques envoyés à chaque appel, en plus du code de
  // réservation (cf. nfcCodeParam) — ex: {"cardType":"guest"}.
  nfcEndpointBodyParams Json?
  // Nom du paramètre (query si GET, corps si POST) qui porte le code de la
  // réservation à encoder.
  nfcCodeParam String? @default("code")
  // Dot-path optionnel dans la réponse pour lire le nombre de cartes
  // encodées (ex: "cardsEncoded") — si vide, un appel réussi (2xx) compte
  // simplement pour 1.
  nfcResponseCountPath String?

  // Récupération du QR code / code d'accès (onglet "Clé digitale" de
  // l'espace client, cf. checkin.html espRenderQr) — même principe que
  // l'encodage NFC ci-dessus : endpoint séparé prenant UNE réservation en
  // paramètre. Inerte tant que qrEndpointPath est vide : le client affiche
  // alors un QR de démonstration (pattern local, non fonctionnel sur un
  // vrai lecteur) plutôt qu'une erreur — utile en confère/démo avant que le
  // connecteur réel soit configuré. Une fois configuré, une erreur de ce
  // endpoint est en revanche remontée explicitement au client plutôt que de
  // se rabattre silencieusement sur la démo (un faux QR qui a l'air valide
  // mais ne fonctionnerait pas sur un vrai lecteur serait pire qu'une
  // erreur visible).
  qrEndpointPath       String? // ex: "/ws/access/qrcode" — concaténé à baseUrl
  qrEndpointMethod     String? @default("GET") // GET | POST
  qrEndpointBodyFormat String? @default("json") // form | json
  qrEndpointBodyParams Json?
  qrCodeParam          String? @default("code") // nom du paramètre code réservation
  // Nom du paramètre optionnel portant l'email du client — certaines
  // sources (ex : API Sesame Technology, /ws/pass/findMimeSecret) exigent
  // un second identifiant en plus du code de réservation pour retrouver le
  // bon pass. Laisser vide si la source n'en a pas besoin.
  qrEmailParam String?
  // Dot-path vers une image déjà prête dans la réponse (base64/data URI/URL)
  // — prioritaire sur qrValuePath si les deux sont renseignés.
  qrImagePath String?
  // Dot-path vers une valeur brute (texte/URL) à encoder nous-même en QR
  // (bibliothèque "qrcode") si la source ne renvoie pas d'image toute faite.
  qrValuePath String?
  // Dot-path vers un code d'accès texte/numérique distinct du QR, s'il est
  // présent dans LA MÊME réponse que qrEndpointPath (ex: code à composer
  // sur un digicode en secours). Si vide et que qrPasscodeEndpointPath est
  // renseigné, ce second endpoint est appelé à la place (ex : API Sesame
  // Technology, dont le passcode est un appel séparé du QR).
  qrAccessCodePath String?
  // Dot-path optionnel vers la date/heure d'expiration du QR ou du code.
  qrValidUntilPath String?
  // Endpoint optionnel pour récupérer le code d'accès SÉPARÉMENT du QR (ex
  // : API Sesame Technology, /ws/pass/findPasscode — un appel distinct de
  // celui du QR). Mêmes connexion/méthode/format/paramètres que
  // qrEndpointPath ci-dessus (code réservation + email). Ignoré si
  // qrAccessCodePath a déjà trouvé un code dans la réponse de qrEndpointPath.
  qrPasscodeEndpointPath String?
  // Dot-path du code dans la réponse de qrPasscodeEndpointPath — vide =
  // "passcode" par défaut.
  qrPasscodeValuePath String?

  // Ouverture de porte à distance (bouton "Ouvrir la porte" du même onglet
  // "Clé digitale") — même principe : endpoint séparé prenant UNE
  // réservation (et, si doorRoomParam est renseigné, sa chambre
  // sélectionnée) en paramètre. Inerte tant que doorEndpointPath est vide :
  // le client garde alors le bouton "Simuler l'ouverture" existant. Une
  // fois configuré, un échec est remonté explicitement — jamais un faux
  // succès, une porte non ouverte doit rester visiblement non ouverte.
  doorEndpointPath       String? // ex: "/ws/lock/open" — concaténé à baseUrl
  doorEndpointMethod     String? @default("POST") // GET | POST
  doorEndpointBodyFormat String? @default("json") // form | json
  doorEndpointBodyParams Json?
  doorCodeParam          String? @default("code") // nom du paramètre code réservation
  // Nom du paramètre optionnel portant l'email du client — même principe
  // que qrEmailParam (ex : API Sesame Technology, /ws/booking/openAs).
  doorEmailParam String?
  // Noms des paramètres optionnels portant nom/prénom du client — certaines
  // sources exigent ces champs plutôt que (ou en plus de) l'email malgré ce
  // que suggère leur documentation : constaté en pratique sur l'API Sesame
  // Technology, /ws/booking/openAs rejette un appel bookingCode+email+
  // facilityCode ("personLastname,bookingCode,facilityCode are mandatory")
  // et exige en réalité personLastname (variante bookingCode+personLastname
  // +personFirstname+facilityCode de la doc officielle).
  doorLastnameParam  String?
  doorFirstnameParam String?
  // Nom du paramètre optionnel portant le code de la chambre sélectionnée
  // (facilityCode/selectedRoomCode) — laisser vide si la source n'a besoin
  // que du code réservation pour savoir quelle porte ouvrir.
  doorRoomParam String?
  // Dot-path optionnel dans la réponse pour vérifier un statut explicite
  // (ex: "success") — si vide, un appel réussi (2xx) suffit à considérer la
  // porte ouverte.
  doorResponseSuccessPath String?

  // Mise à jour d'une réservation (panneau "Réservations" — changement de
  // chambre ou annulation/réactivation) — même principe que les endpoints
  // ci-dessus : endpoint séparé prenant UNE réservation en paramètre. La
  // réservation est TOUJOURS mise à jour localement même si cet appel
  // échoue ou n'est pas configuré (source de vérité de l'app) — l'appel à
  // la source externe est une répercussion best-effort, jamais bloquante :
  // un avertissement (pas une erreur) est renvoyé au panneau si l'appel
  // échoue une fois configuré. Inerte tant que updateEndpointPath est vide.
  updateEndpointPath       String? // ex: "/ws/booking/update" — concaténé à baseUrl
  updateEndpointMethod     String? @default("POST") // GET | POST
  updateEndpointBodyFormat String? @default("json") // form | json
  updateEndpointBodyParams Json?
  updateCodeParam          String? @default("code") // nom du paramètre code réservation
  // Nom du paramètre optionnel portant le nouveau code de chambre — laisser
  // vide si la source externe ne doit pas être notifiée des changements de
  // chambre.
  updateRoomParam String?
  // Nom du paramètre optionnel portant le nouveau statut local (confirmed |
  // checkin_done | completed | cancelled) — laisser vide si la source
  // externe ne doit pas être notifiée des annulations/réactivations. La
  // VALEUR envoyée est traduite via updateStatusValueMap avant l'appel (le
  // vocabulaire de statut local ne correspond pas forcément à celui de la
  // source — ex : l'API Sesame Technology attend "cancel"/"checkedin"/
  // "checkedout"/"confirmed", pas les valeurs locales telles quelles).
  updateStatusParam String?
  // {"confirmed":"...", "checkin_done":"...", "completed":"...",
  // "cancelled":"..."} — statut local -> valeur externe. Statut envoyé tel
  // quel si la map ou l'entrée correspondante est absente.
  updateStatusValueMap Json?
  // Nom du paramètre optionnel portant le type de réservation
  // (Booking.bookingType, ex: "typeCode"/"typeId"/"type" côté API Sesame
  // Technology — code/id/nom du type selon ce que la source attend) —
  // laisser vide si la source externe ne doit pas être notifiée de ce
  // changement.
  updateBookingTypeParam String?
  // Noms des paramètres optionnels portant les nouvelles dates de séjour
  // (format YYYY-MM-DD) — laisser vide si la source externe ne doit pas
  // être notifiée des changements de dates.
  updateStartDateParam String?
  updateEndDateParam   String?

  // null = synchronisation manuelle uniquement ("Importer maintenant").
  syncIntervalMinutes Int?

  lastSyncAt      DateTime?
  lastSyncStatus  String? // success | error
  lastSyncMessage String?
  lastSyncCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Connecteur Mon Casier Frais (docs.moncasierfrais.fr/api) — casiers réfrigérés
// vendant des produits locaux, associés à ce Hôtel via un "module" (une
// installation physique de casiers). Contrairement à BookingSourceConfig
// (générique, forme d'API inconnue à l'avance), c'est une API réelle et
// documentée avec des endpoints fixes — pas besoin de chemins/mapping
// configurables, seulement les identifiants et le module concerné. API
// externe en LECTURE SEULE côté leur documentation (2026) : on ne fait que
// lire leur catalogue/stock et écrire pour réserver/annuler un casier.
model LockerSourceConfig {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  enabled  Boolean @default(false)
  baseUrl  String? @default("https://api.moncasierfrais.fr/v1")
  // Jeton Bearer créé depuis le portail Mon Casier Frais (ApiToken).
  apiToken String?
  // En-tête HTTP optionnel "SellerGroupId" — nécessaire seulement si le
  // jeton donne accès à plusieurs groupes vendeur.
  sellerGroupId String?
  // Identifiant du module (installation de casiers) associé à cet
  // établissement — cf. GET /v1/modules pour aider l'admin à le trouver
  // (bouton "Charger les modules" côté panneau).
  moduleId String?
  // Catégorie boutique appliquée aux produits importés (le catalogue temps
  // réel de la source ne renvoie pas de nom de catégorie lisible par
  // défaut — enrichi via GET /v1/products + /v1/product-types quand
  // possible, ce champ sert de repli).
  defaultCategory String? @default("Mon Casier Frais")
  // Mode démo — affiche et rend commandables côté boutique client les
  // produits importés même quand leur stock réel (stockQty) est à 0.
  // Utile quand le compte Mon Casier Frais connecté est un environnement
  // de développement/sandbox sans casiers physiquement garnis : permet de
  // montrer le catalogue sans attendre un vrai réapprovisionnement.
  // N'affecte QUE l'affichage — la réservation de casier à la commande
  // revérifie toujours le stock réel en direct (cf. reserveLockersForOrder)
  // et échoue proprement (avertissement non bloquant) si le stock est
  // toujours à 0 au moment de la commande, ce mode ne fabrique jamais une
  // fausse réservation.
  showOutOfStock Boolean @default(false)

  // null = synchronisation manuelle uniquement ("Importer maintenant").
  syncIntervalMinutes Int?

  lastSyncAt      DateTime?
  lastSyncStatus  String? // success | error
  lastSyncMessage String?
  lastSyncCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Occupant {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ageCategory String // adulte | ado | enfant | bebe
}

// Équivalent taxe_sejour_record
