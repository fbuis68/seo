// Catalogue boutique / room service — unifié (CFG.roomServiceCatalog)
model Product {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  category    String
  label       String
  description String?
  price       Float
  icon        String?
  photo       String?
  photos      Json?
  videoUrl    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  // Produit importé d'une source externe (cf. LockerSourceConfig / Mon
  // Casier Frais) plutôt que saisi manuellement par l'hôtel. importedFrom
  // vide = produit boutique classique, non touché par la synchronisation.
  // externalId identifie l'article précis côté source (un même produit
  // physique avec plusieurs conditionnements — ex : Comté 0.5kg / 1kg —
  // devient une ligne Product par conditionnement, cf. lib/lockerSource.ts)
  // pour permettre une resynchronisation sans doublon.
  importedFrom String?
  externalId   String?
  // Quantité actuellement disponible en casier au dernier sync — null =
  // pas de suivi de stock (produit boutique classique, toujours affiché).
  // 0 = en rupture, masqué côté boutique client (cf. /product/public).
  stockQty Int?
  // Casiers physiques actuellement associés à ce conditionnement au dernier
  // sync ([{numberOnModule, lockerPrice, state}]) — indicatif seulement, la
  // réservation réelle revérifie toujours la disponibilité en direct auprès
  // de la source au moment de la commande (cf. reserveLockersForOrder).
  lockerLayout Json?
  // Taux de TVA transmis par la source, répercuté vers la réservation de
  // casier (paramètre VAT de /order/bookLockers) — sans rapport avec la
  // fiscalité interne de l'hôtel.
  vatRate Float?
  // Forcer l'affichage "disponible" malgré stockQty=0 — réglable PAR
  // PRODUIT depuis la fiche (contrairement à LockerSourceConfig.showOutOfStock
  // qui est global à tout le connecteur). Utile en environnement de
  // démo/sandbox sans casiers physiquement garnis. N'affecte que l'affichage
  // côté boutique client — jamais la réservation à la commande, qui
  // revérifie toujours le stock réel en direct (cf. reserveLockersForOrder).
  forceInStock Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([entityId, externalId])
}

// Commande — fusionne SCH_ORDERS (boutique) + SESAME_RS_ORDERS (room service)
// de l'ancien prototype en une seule table, conformément à la cible
// production décrite dans le dossier de lancement (endpoint /wa/roomservice/*).
model Order {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  bookingCode String?

  source     String // checkin | roomservice | boutique_standalone
  clientName String?
  roomCode   String?
  roomName   String?

  items Json // [{id,label,price,qty}]
  total Float
  note  String?

  status String @default("new") // new | preparing | delivering | delivered | cancelled

  // Réservation de casier Mon Casier Frais associée à cette commande (créée
  // en best-effort à la commande si des articles importés y figurent, cf.
  // lib/lockerSource.ts reserveLockersForOrder) — jamais bloquante : la
  // commande locale existe toujours même si cet appel échoue ou n'est pas
  // configuré, auquel cas lockerSourceWarning porte le message d'erreur.
  lockerNumbers       Json? // numéros de casier (numberOnModule) attribués, pour affichage client
  lockerPickupCode    String? // code de retrait à 6 chiffres transmis à la source
  lockerSourceOrderId String? // id de la réservation côté source (pour annulation)
  lockerSourceWarning String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Préférences client post check-in (ménage, tags de chambre)
model ClientPrefs {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  email      String
  menageFreq Int?
  servFreq   Int?
  menageNote String?
  tags       Json?

  updatedAt DateTime @updatedAt

  @@unique([entityId, email])
}

// Solde de fidélité. Scope par établissement (entityId) normalement, ou par
// groupe (groupId) quand le groupe de l'établissement a loyaltyMode =
// "centralized" — un seul solde, cumulé, partagé par tous les hôtels du
// groupe pour un même client (cf. resolveLoyaltyScope() côté serveur).
// Exactement un des deux (entityId XOR groupId) est renseigné par ligne.
model LoyaltyAccount {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  email       String
  totalPoints Int    @default(0)

  transactions LoyaltyTransaction[]

  @@unique([entityId, email])
  @@unique([groupId, email])
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  earned      Int     @default(0)
  spent       Int     @default(0)
  bookingCode String?

  createdAt DateTime @default(now())
}

// Livret digital — rubriques éditées par l'admin (phase 2), consultées par
