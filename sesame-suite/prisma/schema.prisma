// Sesame Technology — Suite Hôtelière
// Schéma PostgreSQL — modèle inspiré des 7 tables "sesamelite" décrites dans
// la documentation technique, étendu aux entités nécessaires au parcours
// client complet (chambres, réservations, catalogue boutique, fidélité,
// livret digital, ménage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-tenant : un Hôtel = une Entity (isolation par entityId partout,
// principe 4 du framework fmk documenté).
// ─────────────────────────────────────────────────────────────────────────
model Entity {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  config            EntityModuleConfig?
  rooms             Room[]
  bookings          Booking[]
  products          Product[]
  orders            Order[]
  taxeRecords       TaxeSejourRecord[]
  clientPrefs       ClientPrefs[]
  loyaltyAccounts   LoyaltyAccount[]
  livretSections    LivretSection[]
  housekeepingTasks HousekeepingTask[]
  housekeepingStaff HousekeepingStaff[]
  adminUsers        AdminUser[]
  campaigns         Campaign[]
  subscriptions     Subscription[]
  bookingSource     BookingSourceConfig?
  crmProspects      CrmProspect[]
  smtpConfig        SmtpConfig?
  messageTemplates  MessageTemplate[]
  channelConfigs    ChannelConfig[]
  automationRules   AutomationRule[]
}

// Groupe d'établissements (ex : chaîne hôtelière) — gestion réservée aux
// comptes Sesame. loyaltyMode/ecoMode déterminent si la politique
// correspondante est centralisée (un seul réglage partagé, points de
// fidélité cumulés sur tout le groupe) ou seulement "copiée" au moment du
// rattachement puis gérée indépendamment par chaque établissement ensuite.
model Group {
  id   String @id @default(cuid())
  code String @unique
  name String

  loyaltyMode String @default("independent") // centralized | independent
  ecoMode     String @default("independent") // centralized | independent

  // Utilisés uniquement quand le mode correspondant est "centralized" —
  // mêmes formes que EntityModuleConfig.gains / .loyaltyTiers et le
  // sous-ensemble de champs éco (eauMenage, eauServ, co2Factor, freqOpts,
  // exoEnf, reducAdos, exoHand).
  sharedGains        Json?
  sharedLoyaltyTiers Json?
  sharedEco          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities        Entity[]
  loyaltyAccounts LoyaltyAccount[]
}

// Compte back-office (panneau admin). role="hotel" : géranté par un seul
// établissement (son entityId). role="sesame" : compte Sesame, rattaché à
// une entité technique interne ("Sesame HQ") mais peut agir sur n'importe
// quel établissement via entityCode (cf. resolveEntity côté serveur) —
// c'est le compte qui crée/gère les autres établissements.
model AdminUser {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  name         String?
  role         String  @default("hotel") // sesame | hotel
  // Rôle fonctionnel au sein de l'équipe Sesame — uniquement pertinent pour
  // role="sesame" (un compte hôtel n'a pas de crmRole). "admin" = accès
  // complet au CRM interne (dont la gestion des utilisateurs CRM eux-mêmes,
  // cf. requireCrmAdmin) ; "commercial" = accès standard.
  crmRole String  @default("commercial")
  active  Boolean @default(true) // désactivation (départ, etc.) sans perdre l'historique — pas de suppression physique

  resetTokens PasswordResetToken[]

  // "Commercial" assigné — uniquement pertinent pour les comptes role="sesame"
  // (l'équipe interne), cf. GET /wa/commercial/list.
  crmProspectsAsCommercial CrmProspect[] @relation("ProspectCommercial")
  crmDealsAsCommercial     CrmDeal[]     @relation("DealCommercial")
  crmTicketsAsAgent        CrmTicket[]   @relation("TicketAgent")

  createdAt DateTime @default(now())
}

// Mot de passe oublié — token à usage unique, seul son hash est stocké (le
// token en clair ne transite que dans l'email envoyé, jamais en base ni
// dans les logs), avec expiration courte (1h, imposée côté application).
model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Équivalent de entity_module_config (35 colonnes dans la doc) — regroupé en
// colonnes JSON typées côté TypeScript pour rester proche de la structure
// CFG consommée telle quelle par le front.
model EntityModuleConfig {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  hotelName   String
  hotelSlogan String?
  hotelAddr   String?
  hotelEmail  String?
  stars       Int     @default(3)

  colors     Json // {primary, primaryLight, accent, headerBg, headerText, bg, cardBg, border, text, btnNav}
  radius     Int     @default(14)
  radiusBtn  Int     @default(8)
  shadow     Boolean @default(true)
  fontTitle  String  @default("'Fraunces',serif")
  fontBody   String  @default("'Sora',sans-serif")
  darkH      Boolean @default(true)
  logoMain   String?
  logoIcon   String?
  msgEco     String?
  msgWelcome String?
  btnLabel   String  @default("Continuer")
  ptsLabel   String  @default("Sesame Points")
  progName   String? @default("Mon programme éco")
  lang       String  @default("fr")
  currency   String  @default("EUR")

  tarifs    Json // number[5] — tarif taxe de séjour par catégorie d'étoiles
  exoEnf    Boolean @default(true)
  reducAdos Boolean @default(true)
  exoHand   Boolean @default(false)

  eauMenage Int   @default(15)
  eauServ   Int   @default(40)
  co2Factor Float @default(0.0003)
  freqOpts  Json // number[] fréquences ménage proposées

  gains          Json // {points:{...}, reduction:{...}, produit:{...}, financier:{...}}
  checkinModules Json // {room:{active,mandatory}, taxe:{...}, kyc:{...}, eco:{...}, boutique:{...}, roomservice:{...}, rewards:{...}}
  rewardCatalog  Json?
  loyaltyTiers   Json? // {gold, premium, perks:{Standard:[],Gold:[],Premium:[]}}

  hotelPlan    String? // image du plan (base64 ou URL)
  roomTags     Json?
  accessPoints Json?
  kpi          Json? // {minPerClean, minPerTowel, hourlyRate, annualStays, checkinMin, checkinAdoption}

  updatedAt DateTime @updatedAt
}

// Équivalent "facility" (chambre)
model Room {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  code        String
  name        String
  floor       Int     @default(0)
  surface     Float?
  category    String?
  type        String?
  capacity    Int?
  rate        Float?
  description String?
  pmr         Boolean @default(false)
  nosmoking   Boolean @default(true)
  connected   Boolean @default(false)
  tags        Json // string[]
  photos      Json // string[]
  available   Boolean @default(true)
  x           Float? // position sur le plan (coordonnées 540x380)
  y           Float?

  createdAt DateTime @default(now())

  bookings           Booking[]
  housekeepingStatus RoomHousekeepingStatus?

  @@unique([entityId, code])
}

model Booking {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  code             String
  personEmail      String
  personFirstname  String
  personLastname   String
  personPhone      String?
  startDate        DateTime
  endDate          DateTime
  roomId           String?
  room             Room?    @relation(fields: [roomId], references: [id])
  facilityCode     String? // dénormalisé — code chambre au moment de la réservation
  facilityName     String?
  status           String   @default("confirmed") // confirmed | checkin_done | completed | cancelled
  otaId            String?
  checkinDone      Boolean  @default(false)
  selectedRoomCode String? // chambre choisie à l'étape 2 (peut différer de facilityCode)
  importedFrom     String? // nom de la source si créée par le connecteur externe (cf. BookingSourceConfig), sinon null

  createdAt DateTime @default(now())

  occupants   Occupant[]
  taxeRecords TaxeSejourRecord[]
  kycRecords  KycRecord[]
  orders      Order[]

  @@unique([entityId, code])
  @@index([personEmail])
}

// Connecteur générique de réservations externes — permet de récupérer les
// réservations d'un PMS/système tiers quelconque (pas seulement un client
// Sesame) via une API REST/JSON dont la forme est décrite par fieldMapping
// (chemins "a.b.c" vers les champs Booking). Un connecteur par établissement.
model BookingSourceConfig {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  enabled      Boolean @default(false)
  sourceName   String? // libellé libre (ex: "Mews", "Opera", "PMS interne")
  // Modèle de connecteur appliqué côté interface (panneau "Intégration
  // réservations") — purement informatif pour l'UI (savoir quelle section
  // "identifiants" afficher et quels réglages techniques pré-remplir/masquer
  // par défaut) : none | sesame | mews | opera | thais. Le reste des champs
  // ci-dessous reste la seule source de vérité utilisée par le connecteur.
  presetId     String? @default("none")
  baseUrl      String?
  endpointPath String? // ex: "/v1/bookings" — concaténé à baseUrl
  // La plupart des API répondent à un simple GET, mais certaines (ex : API
  // Sesame Technology, /wa/booking/list) exigent un POST avec un corps
  // application/x-www-form-urlencoded — souvent juste de la pagination
  // (start/limit). endpointBodyParams n'est envoyé que si endpointMethod="POST".
  // endpointBodyFormat détermine l'encodage du corps POST : "form"
  // (application/x-www-form-urlencoded, ex: Sesame) ou "json" (corps JSON —
  // ex: API Mews, dont l'authentification par ClientToken/AccessToken se
  // fait dans le corps de chaque appel plutôt qu'un en-tête ou un jeton).
  endpointMethod     String? @default("GET") // GET | POST
  endpointBodyFormat String? @default("form") // form | json
  endpointBodyParams Json? // ex: {"start":"0","limit":"1000"}

  authType          String  @default("none") // none | apiKey | bearer | basic | login
  authApiKeyHeader  String? // ex: "X-API-Key"
  authApiKeyValue   String?
  authBearerToken   String?
  authBasicUser     String?
  authBasicPassword String?

  // authType="login" — flux en deux temps (ex : API Sesame Technology) :
  // POST identifiants vers loginPath, extraction du token via
  // loginTokenPath, puis ce token est envoyé en en-tête sur chaque appel
  // suivant. Relancé à chaque synchronisation (pas de cache de token).
  loginPath            String? // ex: "/ws/login/login" — concaténé à baseUrl
  loginEmail           String?
  loginPassword        String?
  loginEmailField      String? @default("login") // nom du champ email (body ou query selon loginEmailLocation)
  loginPasswordField   String? @default("password") // nom du champ mot de passe (toujours en body JSON)
  loginEmailLocation   String? @default("body") // query | body
  loginTokenPath       String? // dot-path du token — dans la réponse complète, ou dans le profil sélectionné ci-dessous si loginProfileListPath est renseigné (ex: "token")
  loginTokenHeaderName String? @default("Authorization")
  loginTokenPrefix     String? // ex: "Bearer " — laisser vide pour envoyer le token brut
  // Optionnel — quand la réponse de connexion contient un tableau avec un
  // profil par établissement (ex : API Sesame Technology, un même compte a
  // accès à plusieurs hôtels), ces 3 champs retrouvent le bon profil au lieu
  // de dépendre de sa position dans le tableau. loginTokenPath s'applique
  // alors au profil trouvé, pas à la réponse entière.
  loginProfileListPath   String? // dot-path du tableau de profils (ex: "data.profiles")
  loginProfileMatchField String? // nom du champ à comparer dans chaque profil (ex: "entityCode")
  loginProfileMatchValue String? // valeur recherchée (ex: "CHURCHILL")
  // Filtre de sécurité optionnel — certaines API "login" à profils multiples
  // (ex : Sesame Technology) n'appliquent pas de cloisonnement strict par
  // profil sur tous leurs endpoints : le token authentifie le COMPTE, pas
  // nécessairement l'établissement sélectionné ci-dessus, et peut renvoyer
  // des données d'autres établissements accessibles par ce même compte
  // (confirmé en pratique sur /wa/booking/list). Quand renseigné, seuls les
  // éléments dont ce champ (dot-path, ex: "entityId") correspond à
  // l'"entityId" du profil sélectionné sont conservés.
  resultEntityField String?
  // Champ optionnel supplémentaire envoyé dans le corps JSON de connexion, en
  // plus de l'email et du mot de passe — ex: certains systèmes multi-comptes
  // exigent un identifiant de client/groupe ("client": "monGroupe").
  loginExtraField String?
  loginExtraValue String?

  // Chemin (dot-path) vers le tableau de réservations dans la réponse JSON —
  // vide/null si la réponse EST déjà le tableau.
  responseListPath String?
  // {code, personEmail, personFirstname, personLastname, personPhone,
  //  startDate, endDate, facilityCode, status} -> chemin dot-path dans
  // chaque élément du tableau (ex: {"code":"id","personEmail":"guest.email"}).
  fieldMapping     Json?

  // Chambres / espaces (facilities) — même principe que les réservations
  // ci-dessus, sur un endpoint séparé (même connexion/auth). Les importer
  // avec les codes exacts de la source externe permet ensuite au mapping
  // "facilityCode" des réservations de retrouver la bonne chambre.
  facilityEndpointPath     String? // ex: "/ws/facility/list" — concaténé à baseUrl
  facilityEndpointMethod     String? @default("GET") // GET | POST — cf. endpointMethod
  facilityEndpointBodyFormat String? @default("form") // form | json — cf. endpointBodyFormat
  facilityEndpointBodyParams Json?
  facilityResponseListPath String?
  // {code, name, floor, category, capacity, surface} -> chemin dot-path.
  facilityFieldMapping     Json?

  // null = synchronisation manuelle uniquement ("Importer maintenant").
  syncIntervalMinutes Int?

  lastSyncAt      DateTime?
  lastSyncStatus  String? // success | error
  lastSyncMessage String?
  lastSyncCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Occupant {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ageCategory String // adulte | ado | enfant | bebe
}

// Équivalent taxe_sejour_record
model TaxeSejourRecord {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id])
  bookingCode  String
  facilityCode String?

  checkinDate  DateTime
  checkoutDate DateTime?
  nights       Int

  occupantsTotal   Int
  occupantsAdultes Int
  occupantsAdos    Int
  occupantsEnfants Int
  occupantsBebes   Int

  tarifPerNightPerPerson Float
  montantBrut            Float
  montantDeduction       Float
  montantNet             Float
  devise                 String @default("EUR")

  createdAt DateTime @default(now())
}

// Vérification d'identité (étape 4, optionnelle) — simulation OCR/selfie
// côté client, seul le résultat final est persisté.
model KycRecord {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  docType        String?
  fields         Json?
  idVerified     Boolean @default(false)
  selfieVerified Boolean @default(false)
  matchScore     Int     @default(0)
  skipped        Boolean @default(false)

  createdAt DateTime @default(now())
}

// Catalogue boutique / room service — unifié (CFG.roomServiceCatalog)
model Product {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  category    String
  label       String
  description String?
  price       Float
  icon        String?
  photo       String?
  photos      Json?
  videoUrl    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
}

// Commande — fusionne SCH_ORDERS (boutique) + SESAME_RS_ORDERS (room service)
// de l'ancien prototype en une seule table, conformément à la cible
// production décrite dans le dossier de lancement (endpoint /wa/roomservice/*).
model Order {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  bookingCode String?

  source     String // checkin | roomservice | boutique_standalone
  clientName String?
  roomCode   String?
  roomName   String?

  items Json // [{id,label,price,qty}]
  total Float
  note  String?

  status String @default("new") // new | preparing | delivering | delivered | cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Préférences client post check-in (ménage, tags de chambre)
model ClientPrefs {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  email      String
  menageFreq Int?
  servFreq   Int?
  menageNote String?
  tags       Json?

  updatedAt DateTime @updatedAt

  @@unique([entityId, email])
}

// Solde de fidélité. Scope par établissement (entityId) normalement, ou par
// groupe (groupId) quand le groupe de l'établissement a loyaltyMode =
// "centralized" — un seul solde, cumulé, partagé par tous les hôtels du
// groupe pour un même client (cf. resolveLoyaltyScope() côté serveur).
// Exactement un des deux (entityId XOR groupId) est renseigné par ligne.
model LoyaltyAccount {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  email       String
  totalPoints Int    @default(0)

  transactions LoyaltyTransaction[]

  @@unique([entityId, email])
  @@unique([groupId, email])
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  earned      Int     @default(0)
  spent       Int     @default(0)
  bookingCode String?

  createdAt DateTime @default(now())
}

// Livret digital — rubriques éditées par l'admin (phase 2), consultées par
// le client dès maintenant.
model LivretSection {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  title     String
  icon      String?
  content   String // HTML riche
  sortOrder Int     @default(0)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomHousekeepingStatus {
  id     String @id @default(cuid())
  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  status       String  @default("libre") // libre | occupee | menage | action | hors_service
  currentGuest String?
  bookingCode  String?
  ecoPrefs     Json?

  updatedAt DateTime @updatedAt
}

model HousekeepingStaff {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name              String
  color             String?
  team              String?
  // Codes des chambres assignées — cf. principe "joins/extras XML" de la doc,
  // ici simplifié en tableau JSON plutôt qu'une table de liaison dédiée.
  assignedRoomCodes Json    @default("[]")

  createdAt DateTime @default(now())
}

// Tâches planifiées — génération automatique depuis les préférences éco
// client (HousekeepingTaskDao.createEcoAutoTasks() décrit dans la doc) ou
// création manuelle depuis le planning admin.
model HousekeepingTask {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  roomCode        String
  taskDate        DateTime
  type            String   @default("menage") // menage | linge | entretien | controle | autre
  subtype         String?
  bookingCode     String?
  ecoAuto         Boolean  @default(false)
  status          String   @default("planned") // planned | done | cancelled
  priority        String   @default("normal") // normal | urgent
  durationMinutes Int?
  assignedStaffId String?
  notes           String?

  createdAt DateTime @default(now())
}

// Campagnes marketing (email/SMS) — segmentation calculée à l'envoi depuis
// la base clients (réservations + fidélité), pas de table de destinataires
// dédiée pour cette itération.
model Campaign {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel      String // email | sms
  templateKey  String?
  subject      String?
  content      String?
  audienceDesc String? // description lisible du segment ciblé
  audienceSize Int     @default(0)
  status       String  @default("sent") // draft | sent

  createdAt DateTime @default(now())
}

// Demande/contrat de souscription — panneau "Souscriptions" (back-office
// Sesame). entityId reste null tant que l'abonnement est en essai et n'a
// pas encore été activé (l'établissement n'existe pas encore en base) ;
// l'activation provisionne l'Entity + son AdminUser (cf. provisionEntity()).
model Subscription {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  crmProspect CrmProspect?

  hotelName    String
  stars        Int     @default(3)
  contactEmail String
  contactPhone String?
  pmsLabel     String?

  modules      Json  @default("[]") // string[] clés de modules souscrits
  basePrice    Float
  modulePrices Json  @default("{}") // {moduleKey: prix} — snapshot à la souscription
  monthlyTotal Float

  paymentIbanHolder String?
  paymentIbanLast4  String?

  status      String    @default("trial") // trial | active | expired | cancelled
  trialDays   Int       @default(30)
  trialEnd    DateTime?
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Grille tarifaire globale du wizard d'inscription (ligne unique id="global").
model PricingConfig {
  id           String   @id @default("global")
  basePrice    Float    @default(49)
  trialDays    Int      @default(30)
  modulePrices Json     @default("{}") // {moduleKey: prix}
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// CRM commercial interne de Sesame — pipeline prospects/clients, distinct du
// CRM par établissement (module clientPrefs/CrmProspect gère les hôtels eux-
// mêmes en tant que comptes, pas leurs clients finaux). Réservé aux comptes
// "sesame" (cf. requireSesame). Un enregistrement est créé automatiquement
// à chaque inscription complétée via le wizard d'onboarding public.
// ─────────────────────────────────────────────────────────────────────────
model CrmProspect {
  id String @id @default(cuid())

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  subscriptionId String?      @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  nom            String
  type           String  @default("Client") // Prospect | Client — auto "Prospect" pour les arrivées onboarding/formulaire de contact
  groupe         String?
  secteur        String?
  ville          String?
  etoiles        String?
  danger         String  @default("Modéré") // Bon client | Modéré | Élevé !!
  potentiel      Int     @default(0) // 0-3
  contrat        String  @default("non") // non | oui | en cours
  modules        Int     @default(0)
  pms            String?
  priorite       Int     @default(0) // 0-3
  appel          String? // date libre ("16/10/25") ou "Ne pas appeler"
  referent       String?
  email          String?
  tel            String?
  site           String?
  nfc            Int     @default(0) // % d'usage — les 4 se totalisent à 100% par fiche
  qr             Int     @default(0)
  mobile         Int     @default(0)
  code           Int     @default(0)
  webApp         Boolean @default(false)
  mobileV2       Boolean @default(false)
  checkin        Boolean @default(false)
  livret         Boolean @default(false)
  gestionDemande Boolean @default(false)
  offline        Boolean @default(false)
  // Parcours activés côté client final — par défaut selon le secteur
  // (cf. sectorGroupFor() côté seed/front), éditables ensuite par fiche.
  onbChoixChambres Boolean @default(false) // Onboarding : choix de la chambre
  onbOccupant      Boolean @default(false) // Onboarding : déclaration des occupants
  onbIdentite      Boolean @default(false) // Onboarding : vérification d'identité
  onbMenage        Boolean @default(false) // Onboarding : préférences ménage
  espBoutique      Boolean @default(false) // Espace client : boutique / room service
  espPoint         Boolean @default(false) // Espace client : solde de points fidélité
  espEvenement     Boolean @default(false) // Espace client : évènements/offres de l'établissement
  messagerie     String  @default("Noreply") // Noreply | Client
  note           String?

  // Signal d'engagement entrant — alimenté par POST /wa/crmProspect/inboundSignal
  // (flux Power Automate générique sur les boîtes partagées fbuis@/jtlod@
  // sesame-technology.com, cf. README) : incrémenté à chaque email reçu d'une
  // adresse qui correspond à cette fiche, sans jamais stocker le contenu.
  inboundReplyCount  Int       @default(0)
  lastInboundReplyAt DateTime?

  // Commercial Sesame en charge de ce client/prospect (compte role="sesame").
  commercialId String?
  commercial   AdminUser? @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  deals CrmDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities CrmActivity[]
  tickets    CrmTicket[]
}

// ─────────────────────────────────────────────────────────────────────────
// Module "Gestion des affaires" — pipeline commercial greffé sur le CRM
// Sesame (18/08/2026). Une "affaire" (deal) représente une opportunité de
// vente pour un client/prospect donné ; plusieurs affaires possibles par
// fiche (upsell, renouvellement...). Les devis (CrmQuote) sont rattachés à
// une affaire, pas directement à la fiche, pour garder l'historique des
// versions/négociations d'une même opportunité.
// ─────────────────────────────────────────────────────────────────────────
model CrmDeal {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  commercialId String?
  commercial   AdminUser? @relation("DealCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  title       String
  stage       String    @default("Nouveau") // Nouveau | Qualification | Devis envoyé | Négociation | Gagné | Perdu
  amount      Float     @default(0) // valeur mensuelle estimée (MRR) de l'affaire
  probability Int       @default(20) // 0-100 — pondère "amount" pour la valeur pondérée du pipeline
  closeDate   DateTime? // date de clôture prévue/réelle selon l'étape
  lostReason  String?

  quotes CrmQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Devis — lignes libres en JSON pour rester "souple" (catalogue de modules
// Sesame ET lignes personnalisées mélangés) tout en restant "automatique"
// (le constructeur de devis pré-remplit les lignes de modules depuis le même
// catalogue de prix que le wizard d'inscription, cf. ONBOARDING_MODULES /
// PricingConfig — une seule source de vérité tarifaire dans toute l'app).
model CrmQuote {
  id     String  @id @default(cuid())
  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  number String @unique // ex: DEV-2026-0001
  status String @default("brouillon") // brouillon | envoyé | accepté | refusé

  lines       Json    @default("[]") // [{label, description?, qty, unitPrice, recurring:bool}] — description = sous-texte verbeux affiché sous le libellé, comme sur les devis Sesame réels
  discountPct Float   @default(0)
  notes       String?
  sentAt      DateTime?

  // Signature électronique simple (18/08/2026) — signToken donne accès à la
  // page publique de signature (public/devis-signature.html), sans compte
  // CRM. Volontairement PAS une signature électronique qualifiée (eIDAS) :
  // capture nom saisi + tracé + horodatage/IP à titre de preuve de
  // consentement, à la manière d'un "clic pour accepter" plutôt qu'une
  // signature certifiée par un tiers de confiance (Yousign/DocuSign...).
  signToken String?             @unique
  signature CrmQuoteSignature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmQuoteSignature {
  id      String   @id @default(cuid())
  quoteId String   @unique
  quote   CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  signerName       String
  signerEmail      String?
  signatureDataUrl String @db.Text // image PNG (canvas) encodée en base64
  ip               String?
  userAgent        String?

  signedAt DateTime @default(now())
}

// Catalogue produits interne Sesame (18/08/2026) — distinct du catalogue
// "modules" SaaS (ONBOARDING_MODULES/PricingConfig, utilisé pour le pricing
// des souscriptions) : ici du matériel et des prestations facturables au
// devis (contrôles d'accès, gateway, formation...), avec un indicateur
// stockable/non-stockable en prévision d'une gestion de stock à venir —
// stockQty existe déjà dans le modèle mais n'est lu/écrit nulle part pour
// l'instant, volontairement, tant que cette gestion de stock n'est pas
// construite.
model CrmProduct {
  id          String  @id @default(cuid())
  sku         String?
  label       String
  description String? // sous-texte verbeux réutilisé sur les lignes de devis
  unitPrice   Float   @default(0)
  recurring   Boolean @default(false) // mensuel (true) ou ponctuel (false)
  stockable   Boolean @default(false)
  stockQty    Int? // réservé à la future gestion de stock — non utilisé pour l'instant
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modèles de devis récurrents (18/08/2026) — pour gagner le temps de
// ressaisie sur des devis au contenu verbeux et répétitif : un modèle porte
// déjà tous les libellés/descriptions/prix, il ne reste qu'à ajuster les
// quantités à la marge lors de la création d'un devis à partir de ce
// modèle (cf. POST /wa/crmQuote/create avec templateId).
model CrmQuoteTemplate {
  id    String @id @default(cuid())
  name  String
  lines Json   @default("[]") // même forme que CrmQuote.lines
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmActivity {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type         String // Appel | Email | Visite | Proposition | Relance | Note interne | Autre
  text         String
  authorName   String?
  activityDate DateTime?
  done         Boolean   @default(false)

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Module Tickets (support) — 19/08/2026. Un client (contact hôtelier déjà
// suivi au CRM, ou nouveau retrouvé/créé par email comme le formulaire de
// contact) ouvre un incident depuis le widget public (public/support.html) ;
// l'équipe Sesame le qualifie (statut/priorité/type/agent) et y répond
// depuis la fiche — réponse envoyée par email réel au contact, note interne
// jamais envoyée. `publicToken` donne au client un lien permanent vers SON
// ticket pour le compléter (note + image) sans repasser par une nouvelle
// ouverture, à la manière de CrmQuote.signToken pour la signature de devis.
// ─────────────────────────────────────────────────────────────────────────
model CrmTicket {
  id         String      @id @default(cuid())
  prospectId String
  prospect   CrmProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AdminUser? @relation("TicketAgent", fields: [agentId], references: [id], onDelete: SetNull)

  subject      String
  status       String  @default("En attente") // En attente | En cours | Attente client | Résolu | Fermé
  priority     String  @default("Normale") // Basse | Normale | Haute | Urgente
  type         String? // Incident technique | Question | Demande | Facturation | Autre
  tags         Json    @default("[]") // string[]
  contactEmail String // qui a ouvert le ticket (peut différer du référent de la fiche)
  contactName  String?
  publicToken  String  @unique @default(cuid())

  messages CrmTicketMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
}

model CrmTicketMessage {
  id       String    @id @default(cuid())
  ticketId String
  ticket   CrmTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType  String // client | agent
  authorName  String?
  kind        String // reply (envoyé par email au client si authorType=agent) | note (interne, jamais envoyée)
  body        String @db.Text
  attachments Json   @default("[]") // string[] data URI — même convention que Room.photos

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Envoi d'email générique — un serveur SMTP sortant + des modèles, réutilisés
// tels quels par le module CRM (entityId=null, portée Sesame) et par le
// back-office de chaque hôtel (entityId=<hôtel>, ses propres modèles/envois).
// @unique sur entityId empêche deux configs pour un même hôtel ; côté null
// (portée globale CRM), PostgreSQL traite chaque NULL comme distinct — la
// route applique donc toujours un "findFirst puis create/update" plutôt que
// de compter sur la contrainte pour ce cas précis.
// ─────────────────────────────────────────────────────────────────────────
model SmtpConfig {
  id       String  @id @default(cuid())
  entityId String? @unique
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  host     String
  port     Int     @default(587)
  secure   Boolean @default(false) // true = SMTPS (465), false = STARTTLS/plain (587/25)
  username String
  password String
  fromName  String?
  fromEmail String

  // Adresse dédiée aux réponses de tickets support (module Tickets,
  // 19/08/2026) — distincte de fromEmail/fromName pour que les échanges
  // support ("L'équipe Support Sesame") ne partent pas sous l'identité
  // générique utilisée pour les autres emails CRM. Retombe sur
  // fromEmail/fromName si non renseignée (cf. ticketFromHeader()).
  supportFromEmail String?
  supportFromName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modèle de message multi-canal — un seul mécanisme de gabarit ({{variable}})
// partagé par l'email (subject+bodyHtml), le SMS et le WhatsApp (bodyHtml
// sert alors de texte brut, subject ignoré). C'est cette convergence de
// modèles, combinée à ChannelConfig et sendMessage() (src/lib/messaging.ts),
// qui permet aux règles d'automatisation de cibler indifféremment l'un des
// trois canaux pour un même déclencheur métier.
model MessageTemplate {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel  String  @default("email") // email | sms | whatsapp
  key      String // slug interne, ex: "prospect-relance" — cible de sendMessage()
  name     String // libellé affiché dans le sélecteur de modèle
  subject  String // email uniquement ; supporte {{variable}}
  bodyHtml String // email : HTML ; sms/whatsapp : texte brut — supporte {{variable}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, channel, key])
}

// Identifiants Twilio pour SMS et WhatsApp — même principe de portée que
// SmtpConfig (entityId=null : CRM/Sesame ; entityId=<hôtel> : back-office).
// Un provider unique (Twilio) couvre les deux canaux avec un seul compte,
// ce qui est la brique qui permet la convergence email/SMS/WhatsApp.
model ChannelConfig {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  channel    String // sms | whatsapp
  provider   String  @default("twilio") // twilio | smspartner (SMS uniquement — pas de WhatsApp chez ce partenaire)
  accountSid String?
  authToken  String?
  fromNumber String? // numéro Twilio (SMS/WhatsApp) ou nom d'émetteur DocPartner/SMSPartner (SMS, 3-11 car.)
  apiKey     String? // clé API DocPartner/SMSPartner.fr — auth par clé unique (provider=smspartner)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, channel])
}

// ─────────────────────────────────────────────────────────────────────────
// Règles d'automatisation — déclenchées soit immédiatement par un événement
// métier (fireTrigger(), appelé depuis les routes concernées), soit par un
// balayage périodique (automationScheduler.ts) pour les déclencheurs relatifs
// à une date (avant/après séjour) ou récurrents (newsletter). AutomationRuleLog
// évite les doublons d'envoi : une ligne par (règle, cible) déjà notifiée.
// ─────────────────────────────────────────────────────────────────────────
model AutomationRule {
  id       String  @id @default(cuid())
  entityId String? // null = portée CRM/Sesame
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name    String
  trigger String // clé du catalogue TRIGGERS (src/lib/automation.ts), ex: "booking.created"
  enabled Boolean @default(true)

  timingMode  String  @default("immediate") // immediate | before | after | recurring
  offsetValue Int? // ex: 1 (timingMode="before"|"after")
  offsetUnit  String? // minutes | hours | days
  recurrence  String? // daily | weekly | monthly (timingMode="recurring")
  atTime      String? // "HH:mm" (timingMode="recurring")
  dayOfWeek   Int? // 0(dim)-6, recurrence="weekly"
  dayOfMonth  Int? // 1-31, recurrence="monthly"

  channel     String // email | sms | whatsapp
  templateKey String

  // Destinataire : par défaut celui de l'événement (client de la réservation,
  // prospect du CRM…) ; "custom" permet de cibler une adresse/numéro fixe à
  // la place — utile pour notifier l'équipe (ex: réception) plutôt que le
  // client sur "order.created".
  recipientMode     String  @default("event") // event | custom
  recipientOverride String? // email ou numéro selon channel, requis si recipientMode="custom"

  // Nom d'expéditeur affiché pour cette règle (email uniquement) — remplace
  // celui de la config SMTP de la portée si renseigné, sinon comportement
  // inchangé (nom de la config).
  senderName String?

  audienceFilter Json? // segment cible pour les règles sans record source unique (ex: crm.newsletter)

  lastRunAt DateTime?

  // Visibilité des échecs — sans ça, un envoi qui échoue (SMTP mal
  // configuré, modèle introuvable…) n'était visible que dans les logs
  // serveur : la règle semblait "ne rien faire" sans qu'on sache pourquoi.
  // Effacé à la prochaine réussite (n'affiche jamais un échec périmé).
  lastError   String?
  lastErrorAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AutomationRuleLog[]
}

model AutomationRuleLog {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  targetType String // "booking" | "order" | "crmProspect" | "period" (newsletter)…
  targetId   String
  sentAt     DateTime       @default(now())

  @@unique([ruleId, targetType, targetId])
}
