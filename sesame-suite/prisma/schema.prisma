  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  title     String
  icon      String?
  content   String // HTML riche
  sortOrder Int     @default(0)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomHousekeepingStatus {
  id     String @id @default(cuid())
  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  status       String  @default("libre") // libre | occupee | menage | action | hors_service
  currentGuest String?
  bookingCode  String?
  ecoPrefs     Json?

  // Statut de propreté détaillé (panneau "Ménage", vue "Statuts chambres",
  // 20260824) — distinct de `status` ci-dessus (occupation), sur le même
  // modèle qu'un connecteur PMS de référence (Thaïs) : une chambre a
  // toujours EXACTEMENT un de ces 8 statuts, mis à jour manuellement par le
  // personnel de ménage. "sale" par défaut (une chambre nouvellement créée
  // est considérée à nettoyer avant sa première occupation).
  cleanStatus String @default("sale") // propre | recouche_lit | recouche_blanc | sale | en_verif | taie_oreiller | serviette | drap

  updatedAt DateTime @updatedAt
}

model HousekeepingStaff {
